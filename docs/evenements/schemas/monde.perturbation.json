{
  "$defs": {
    "DisturbancePayload": {
      "additionalProperties": false,
      "properties": {
        "nature": {
          "$ref": "#/$defs/Perturbation"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "nature",
        "description"
      ],
      "title": "DisturbancePayload",
      "type": "object"
    },
    "Perturbation": {
      "description": "Événements que l'observateur peut injecter en direct (D3). Les quatre dernières natures\narrivent avec la version 1.1 des schémas `monde.perturbation` et `controle.injection`.",
      "enum": [
        "rupture_stock",
        "polemique",
        "vague_chaleur",
        "promotion_concurrente",
        "article_presse",
        "publication_virale",
        "orage"
      ],
      "title": "Perturbation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "description": "Identifiant unique.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "description": "Run qui a produit l'événement.",
      "maxLength": 64,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "type": {
      "const": "monde.perturbation",
      "default": "monde.perturbation",
      "title": "Type",
      "type": "string"
    },
    "sim_time_occurred": {
      "description": "Moment simulé où le fait se produit.",
      "minimum": 0,
      "title": "Sim Time Occurred",
      "type": "integer"
    },
    "sim_time_processed": {
      "description": "Moment simulé où l'émetteur a fini de le traiter (≥ sim_time_occurred).",
      "minimum": 0,
      "title": "Sim Time Processed",
      "type": "integer"
    },
    "wall_time_emitted": {
      "description": "Horodatage réel d'émission, en UTC.",
      "format": "date-time",
      "title": "Wall Time Emitted",
      "type": "string"
    },
    "source_agent_id": {
      "description": "Émetteur : agent ou composant.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Source Agent Id",
      "type": "string"
    },
    "zone": {
      "anyOf": [
        {
          "description": "Zone du monde : « plage », ou « plage_2 » s'il y en a plusieurs ; le nom du type seul désigne tous ses exemplaires.",
          "pattern": "^(pharmacie|plage|piscine|reseaux_sociaux|centre_commercial|terrain_sport|domicile)(_[1-4])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Zone concernée, si elle existe : un lieu (« plage », « plage_2 ») ou, pour une perturbation, un type de zone qui vaut pour tous ses exemplaires.",
      "title": "Zone"
    },
    "caused_by": {
      "default": [],
      "description": "Événements à l'origine de celui-ci (traçabilité, F6).",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Caused By",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/DisturbancePayload"
    }
  },
  "required": [
    "run_id",
    "sim_time_occurred",
    "sim_time_processed",
    "source_agent_id",
    "payload"
  ],
  "title": "Disturbance",
  "type": "object"
}
