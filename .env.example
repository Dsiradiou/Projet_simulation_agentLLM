# Copier ce fichier en .env et compléter. Le fichier .env n'est jamais versionné.
# Les paramètres de simulation (marque, agents, durée, graine...) sont dans configs/*.yaml.

# Services locaux (étapes 2 et 3)
OLLAMA_HOST=http://localhost:11434
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0

# Clés d'API gratuites, facultatives : renfort et plan B, jamais le chemin principal.
# Chaque membre du binôme utilise sa propre clé.
GROQ_API_KEY=
GOOGLE_API_KEY=
GITHUB_MODELS_TOKEN=
